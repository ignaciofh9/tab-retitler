{
  "manifest_version": 3,
  "name": "Tab Retitler",
  "version": "0.9.0",
  "description": "Rename tabs and badge their icons using rules based on each page’s URL and content. Teach it by example in the side panel.",
  "homepage_url": "https://github.com/ignaciofh9/tab-retitler",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "favicon",
    "sidePanel",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Tab Retitler",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "options.html"
  }
}
